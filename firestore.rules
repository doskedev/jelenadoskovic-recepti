rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /recipes/{slug} {
      allow read: if true;
      allow write: if false;
    }

    match /catalog/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid}/marks/{code} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow delete: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'fav', 'made', 'rating', 'note', 'updatedAt'])
        && request.resource.data.code == code
        && code.size() <= 40
        && request.resource.data.fav is bool
        && request.resource.data.made is bool
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 5
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 4000
        && request.resource.data.updatedAt is number;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
