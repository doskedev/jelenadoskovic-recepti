rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (request.auth.token.email == 'doske1992@gmail.com'
            || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /recipes/{slug} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.slug == slug
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 12;
    }

    match /tags/{tag} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.slug == tag;
    }

    match /catalog/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid}/marks/{code} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow delete: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'fav', 'made', 'rating', 'note', 'updatedAt'])
        && request.resource.data.code == code
        && code.size() <= 40
        && request.resource.data.fav is bool
        && request.resource.data.made is bool
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 5
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 4000
        && request.resource.data.updatedAt is number;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
